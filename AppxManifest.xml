<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://microsoft.com" xmlns:uap="http://microsoft.com" xmlns:rescap="http://microsoft.com/restrictedcapabilities">
  
  <Properties>
    <DisplayName>Josesoft Photo Viewer</DisplayName>
    <PublisherDisplayName>Josecast</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="tr-TR" />
    <Resource Language="en-US" />
    <Resource Language="de-DE" />
    <Resource Language="fr-FR" />
    <Resource Language="es-ES" />
    <Resource Language="it-IT" />
    <Resource Language="pt-PT" />
    <Resource Language="pl-PL" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Applications>
    <Application Id="App" Executable="JosesoftPhotoViewer_Store.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Josesoft Photo Viewer" Description="Josesoft Photo Viewer" BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="images">
            <uap:SupportedFileTypes>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
